{
  "name": "openui-self-hosted",
  "version": "0.1.1",
  "private": true,
  "scripts": {
    "generate": "openui generate src/lib/library.ts --spec --out src/generated/spec.json",
    "prompt": "openui generate src/lib/library.ts --out src/generated/system-prompt.txt --prompt-options promptOptions && openui generate src/lib/library.ts --out src/generated/dashboard-system-prompt.txt --prompt-options dashboardPromptOptions && rm -f src/generated/*system-prompt.spec.json",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bench": "node --no-warnings scripts/bench/run.mjs",
    "deploy": "openui deploy"
  },
  "dependencies": {
    "@openuidev/lang-core": "file:vendor/openui/openuidev-lang-core-0.3.1.tgz",
    "@openuidev/react-lang": "file:vendor/openui/openuidev-react-lang-0.3.1.tgz",
    "@openuidev/react-ui": "file:vendor/openui/openuidev-react-ui-0.17.0.tgz",
    "lucide-react": "^0.562.0",
    "maplibre-gl": "^6.13.0",
    "next": "^16.3.1",
    "openai": "^6.22.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@openuidev/cli": "0.4.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild": true,
    "@openuidev/lang-core": false
  },
  "overrides": {
    "@openuidev/lang-core": "file:vendor/openui/openuidev-lang-core-0.3.1.tgz",
    "@openuidev/devtools": "file:vendor/openui/openuidev-devtools-0.2.2.tgz",
    "@openuidev/observability": "file:vendor/openui/openuidev-observability-0.0.4.tgz",
    "@openuidev/react-headless": "file:vendor/openui/openuidev-react-headless-0.17.0.tgz"
  }
}
